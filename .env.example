BOT_TOKEN=
DATABASE_URL=sqlite:///data/poker.db
# Для облака: PostgreSQL из Neon; ключи хранить в Environment Variables Vercel.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
WEBHOOK_SECRET=
# Публичный HTTPS-адрес Mini App: позже, при подключении в Telegram.
MINI_APP_URL=
# text или widgets; пользователь может переключить режим кнопкой
DISPLAY_MODE=text
# Необязательное форматирование итогов через Rich Messages
RICH_MESSAGES=false

